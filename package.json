{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs --production",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:schema && npm run test:m2m:harness",
    "test:domain": "node --experimental-strip-types --test tests/domain/observationDomain.test.ts tests/domain/firestorePersistence.test.ts tests/domain/observationInterchange.test.ts",
    "test:firestore:emulator": "firebase emulators:exec --only firestore --project demo-observer-2 \"node --experimental-strip-types --test tests/emulator/firestoreRules.test.ts\"",
    "test:schema": "node --test tests/schema/schema.test.mjs",
    "contracts:check": "node scripts/check-contract-registry.mjs",
    "verify:m2m:harness": "node scripts/verify-m2m-harness.mjs",
    "test:m2m:harness": "node --test tests/m2m/harness.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.24.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
