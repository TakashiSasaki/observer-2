{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/observation-interchange.schema.json",
  "title": "Observation Interchange Format",
  "description": "Standard JSON Schema for exchanging ObservationSet and its Observations.",
  "type": "object",
  "required": [
    "id",
    "uid",
    "type",
    "title",
    "summary",
    "rawContent",
    "visibility",
    "allowedEmails",
    "tags",
    "observationIds",
    "observations",
    "schemaVersion",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 for the ObservationSet."
    },
    "uid": {
      "type": "string",
      "description": "Creator's unique identifier."
    },
    "observerName": {
      "type": "string"
    },
    "observerPhoto": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "$ref": "#/$defs/ObservationType"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "rawContent": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "imagePath": {
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/LocationData"
    },
    "visibility": {
      "$ref": "#/$defs/VisibilityType"
    },
    "allowedEmails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "$ref": "#/$defs/ObservationMetadata"
    },
    "observationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Must match the IDs of the objects in the 'observations' array in the same order."
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "description": "The individual Observations belonging to this ObservationSet."
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 string representing the creation time."
    }
  },
  "$defs": {
    "VisibilityType": {
      "type": "string",
      "enum": [
        "public",
        "authenticated",
        "shared",
        "private"
      ]
    },
    "ObservationType": {
      "type": "string",
      "enum": [
        "nfc",
        "qr",
        "object",
        "ocr",
        "manual"
      ]
    },
    "LocationData": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "ObservationMetadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nfcTech": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "extractedText": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "textType": {
          "type": "string"
        },
        "keyEntities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detectedObjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Observation": {
      "type": "object",
      "required": [
        "id",
        "parentSetId",
        "uid",
        "type",
        "title",
        "summary",
        "rawContent",
        "visibility",
        "allowedEmails",
        "schemaVersion",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "parentSetId": {
          "type": "string",
          "format": "uuid",
          "description": "Must match the ID of the parent ObservationSet."
        },
        "uid": {
          "type": "string"
        },
        "observerName": {
          "type": "string"
        },
        "observerPhoto": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "$ref": "#/$defs/ObservationType"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "rawContent": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imagePath": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/LocationData"
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityType"
        },
        "allowedEmails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/ObservationMetadata"
        },
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
