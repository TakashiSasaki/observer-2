rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymousWithEmail() {
      return isAuthenticated()
        && request.auth.token.email != null
        && (!('sign_in_provider' in request.auth.token.firebase)
          || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isOwner(data) {
      return isAuthenticated() && data.uid == request.auth.uid;
    }

    function isUuidV7(value) {
      return value is string
        && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function canReadEntity(data) {
      return data.deletedAt == null && (
        data.visibility == 'public'
        || (data.visibility == 'authenticated' && isAuthenticated())
        || (data.visibility == 'shared'
          && isNonAnonymousWithEmail()
          && request.auth.token.email in data.allowedEmails)
        || isOwner(data)
      );
    }

    function hasCommonEntityKeys(data) {
      return data.keys().hasAll([
        'id', 'uid', 'observerName', 'observerPhoto', 'type', 'title', 'summary', 'rawContent',
        'imageUrl', 'imagePath', 'location', 'visibility', 'allowedEmails', 'metadata',
        'schemaVersion', 'createdAt', 'updatedAt', 'deletedAt'
      ]);
    }

    function hasOnlyObservationKeys(data) {
      return data.keys().hasOnly([
        'id', 'uid', 'observerName', 'observerPhoto', 'type', 'title', 'summary', 'rawContent',
        'imageUrl', 'imagePath', 'location', 'visibility', 'allowedEmails', 'metadata',
        'schemaVersion', 'createdAt', 'updatedAt', 'deletedAt'
      ]);
    }

    function hasOnlyObservationSetKeys(data) {
      return data.keys().hasOnly([
        'id', 'uid', 'observerName', 'observerPhoto', 'type', 'title', 'summary', 'rawContent',
        'imageUrl', 'imagePath', 'location', 'visibility', 'allowedEmails', 'tags', 'metadata',
        'schemaVersion', 'createdAt', 'updatedAt', 'deletedAt'
      ]);
    }

    function validLocation(location) {
      return location == null || (
        location is map
        && location.keys().hasAll(['latitude', 'longitude'])
        && location.keys().hasOnly(['latitude', 'longitude', 'accuracy', 'address'])
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180
        && (!location.keys().hasAny(['accuracy'])
          || (location.accuracy is number && location.accuracy >= 0))
        && (!location.keys().hasAny(['address']) || location.address is string)
      );
    }

    function commonEntityFieldsAreValid(data, documentId) {
      return data.id == documentId
        && isUuidV7(data.id)
        && data.uid is string
        && (data.observerName == null || data.observerName is string)
        && (data.observerPhoto == null || data.observerPhoto is string)
        && data.type in ['nfc', 'qr', 'object', 'ocr', 'manual']
        && data.title is string
        && data.summary is string
        && data.rawContent is string
        && (data.imageUrl == null || data.imageUrl is string)
        && (data.imagePath == null || data.imagePath is string)
        && validLocation(data.location)
        && data.visibility in ['public', 'authenticated', 'shared', 'private']
        && data.allowedEmails is list
        && (data.visibility == 'shared' || data.allowedEmails.size() == 0)
        && data.metadata is map
        && data.schemaVersion == '2.0.0'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && (data.deletedAt == null || (data.deletedAt is timestamp && data.deletedAt >= data.createdAt));
    }

    function validNewObservation(data, observationId) {
      return hasCommonEntityKeys(data)
        && hasOnlyObservationKeys(data)
        && commonEntityFieldsAreValid(data, observationId)
        && data.deletedAt == null;
    }

    function validUpdatedObservation(data, observationId) {
      return hasCommonEntityKeys(data)
        && hasOnlyObservationKeys(data)
        && commonEntityFieldsAreValid(data, observationId)
        && resource.data.deletedAt == null
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'observerName', 'observerPhoto', 'type', 'title', 'summary', 'rawContent',
          'imageUrl', 'imagePath', 'location', 'visibility', 'allowedEmails', 'metadata',
          'updatedAt', 'deletedAt'
        ]);
    }

    function validNewObservationSet(data, observationSetId) {
      return hasCommonEntityKeys(data)
        && data.keys().hasAll(['tags'])
        && hasOnlyObservationSetKeys(data)
        && commonEntityFieldsAreValid(data, observationSetId)
        && data.tags is list
        && data.deletedAt == null;
    }

    function validUpdatedObservationSet(data, observationSetId) {
      return hasCommonEntityKeys(data)
        && data.keys().hasAll(['tags'])
        && hasOnlyObservationSetKeys(data)
        && commonEntityFieldsAreValid(data, observationSetId)
        && data.tags is list
        && resource.data.deletedAt == null
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'observerName', 'observerPhoto', 'type', 'title', 'summary', 'rawContent',
          'imageUrl', 'imagePath', 'location', 'visibility', 'allowedEmails', 'tags', 'metadata',
          'updatedAt', 'deletedAt'
        ]);
    }

    function validMembership(data, membershipId) {
      return data.keys().hasAll([
          'id', 'observationSetId', 'observationId', 'uid', 'position', 'schemaVersion', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'observationSetId', 'observationId', 'uid', 'position', 'schemaVersion', 'createdAt'
        ])
        && data.id == membershipId
        && isUuidV7(data.observationSetId)
        && isUuidV7(data.observationId)
        && membershipId == data.observationSetId + '__' + data.observationId
        && data.uid is string
        && data.position is int
        && data.position >= 0
        && data.schemaVersion == '2.0.0'
        && data.createdAt is timestamp;
    }

    function hasActiveOwnedMembershipEndpoints(data) {
      let setPath = /databases/$(database)/documents/observationSets/$(data.observationSetId);
      let obsPath = /databases/$(database)/documents/observations/$(data.observationId);
      
      let setDoc = existsAfter(setPath) ? getAfter(setPath) : null;
      let obsDoc = existsAfter(obsPath) ? getAfter(obsPath) : null;

      return setDoc != null && obsDoc != null
        && setDoc.data.uid == request.auth.uid
        && obsDoc.data.uid == request.auth.uid
        && setDoc.data.get('schemaVersion', 'none') == '2.0.0'
        && obsDoc.data.get('schemaVersion', 'none') == '2.0.0'
        && setDoc.data.get('deletedAt', null) == null
        && obsDoc.data.get('deletedAt', null) == null;
    }

    function canReadMembership(data) {
      // A membership exposes only the relation. Reading it never grants read
      // access to `/observations/{id}`, whose ACL is checked independently.
      return isOwner(data) || canReadEntity(
        get(/databases/$(database)/documents/observationSets/$(data.observationSetId)).data
      );
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.auth.uid == uid;
    }

    match /observations/{observationId} {
      // The owner-scoped import transaction must distinguish a missing
      // candidate from an existing document before it creates anything.
      // Missing-document probes reveal no data; existing reads keep the ACL.
      allow read: if (resource == null && isAuthenticated())
        || (resource != null && canReadEntity(resource.data));
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && validNewObservation(request.resource.data, observationId);
      allow update: if isOwner(resource.data)
        && request.resource.data.uid == resource.data.uid
        && validUpdatedObservation(request.resource.data, observationId);
      // Entity deletion is deliberately logical. Membership deletion is the
      // only physical relation delete permitted in this model.
      allow delete: if false;
    }

    match /observationSets/{observationSetId} {
      // See the corresponding Observation rule: authenticated missing
      // candidate probes support an atomic import without weakening ACL reads.
      allow read: if (resource == null && isAuthenticated())
        || (resource != null && canReadEntity(resource.data));
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && validNewObservationSet(request.resource.data, observationSetId);
      allow update: if isOwner(resource.data)
        && request.resource.data.uid == resource.data.uid
        && validUpdatedObservationSet(request.resource.data, observationSetId);
      allow delete: if false;
    }

    match /observationSetMemberships/{membershipId} {
      // The attach transaction reads the deterministic membership ID before
      // creating it. There is no resource data to authorize in that case;
      // existing membership documents remain constrained by the set ACL.
      allow read: if resource == null || canReadMembership(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && validMembership(request.resource.data, membershipId)
        && hasActiveOwnedMembershipEndpoints(request.resource.data);
      allow update: if isOwner(resource.data)
        && validMembership(request.resource.data, membershipId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position']);
      allow delete: if isOwner(resource.data);
    }
  }
}
